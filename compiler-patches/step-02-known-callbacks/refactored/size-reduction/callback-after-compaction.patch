diff --git a/tests/run/known_callback.bend b/tests/run/known_callback.bend
new file mode 100644
index 00000000..32396654
--- /dev/null
+++ b/tests/run/known_callback.bend
@@ -0,0 +1,19 @@
+import Base
+
+def apply(x: U32, callback: U32 -> U32) -> U32:
+  callback(x)
+
+def with_pair(result: U32 & U32, callback: U32 -> U32 -> U32) -> U32:
+  (a, b) = result
+  callback(a, b)
+
+def run(+bias: U32, x: U32) -> U32:
+  a = apply(x, y => U32.add(y, bias))
+  b = with_pair((a, 2), y => z => U32.add(y, z))
+  c = apply(b, y => U32.add(y, bias))
+  apply(c, y => U32.add(y, bias))
+
+def main() -> U32:
+  run(3, 31)
+
+#| 42
diff --git a/tests/run/known_callback_array.bend b/tests/run/known_callback_array.bend
