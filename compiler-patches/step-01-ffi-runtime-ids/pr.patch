diff --git a/tests/io/foreign_runtime_apply.bend b/tests/io/foreign_runtime_apply.bend
new file mode 100644
index 00000000..574134f2
--- /dev/null
+++ b/tests/io/foreign_runtime_apply.bend
@@ -0,0 +1,12 @@
+# A closure is passed to C without any dynamic application in Bend. The
+# effect must still be able to name the runtime's Clo~apply segment.
+import Base
+
+def native.apply(step: U32 -> U32, value: U32) -> IO(Unit):
+  import "./foreign_runtime_apply.c"
+  import "./foreign_runtime_apply.js"
+
+def main() -> IO(Unit):
+  native.apply(x => (x + 2 : U32), 40)
+
+#|42
diff --git a/tests/io/foreign_runtime_apply.c b/tests/io/foreign_runtime_apply.c
new file mode 100644
index 00000000..9d665faa
--- /dev/null
+++ b/tests/io/foreign_runtime_apply.c
@@ -0,0 +1,14 @@
+static Term native_apply_run(Env e, Term* f, IoWork* w) {
+  (void)w;
+  u64 at = task_node(e, FID(Clo~apply), TERM_HOLE, 0, 0);
+  e.mem[at] = f[0];
+  e.mem[at + 1] = f[1];
+  Term result = corpus_eval(e.mem, term_tsk(FID(Clo~apply), at));
+  if (err_seen(e.mem)) err_fail("foreign closure application failed");
+  printf("%u\n", (u32)result);
+  return term_pak(CID(Unit), 0);
+}
+
+static void __attribute__((constructor)) native_apply_use(void) {
+  io_eff(CID(native.apply), native_apply_run, 0);
+}
