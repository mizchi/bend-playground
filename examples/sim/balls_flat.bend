def box.start(+k: Nat, b0: Ball, b1: Ball, b2: Ball, b3: Ball, b4: Ball, b5: Ball, b6: Ball, b7: Ball) -> Out:
  match b0, b1, b2, b3, b4, b5, b6, b7:
    case Ball{+x0, +y0, +vx0, +vy0} Ball{+x1, +y1, +vx1, +vy1} Ball{+x2, +y2, +vx2, +vy2} Ball{+x3, +y3, +vx3, +vy3} Ball{+x4, +y4, +vx4, +vy4} Ball{+x5, +y5, +vx5, +vy5} Ball{+x6, +y6, +vx6, +vy6} Ball{+x7, +y7, +vx7, +vy7}:
      box.run(k, x0, y0, vx0, vy0, x1, y1, vx1, vy1, x2, y2, vx2, vy2, x3, y3, vx3, vy3, x4, y4, vx4, vy4, x5, y5, vx5, vy5, x6, y6, vx6, vy6, x7, y7, vx7, vy7, 0)

def box(+k: Nat, +i: U32) -> Out:
  +s = seed(i)
  box.start(k, spawn(s, 0, 0.0, 0.0), spawn(s, 1, 1.0, 0.0), spawn(s, 2, 2.0, 0.0), spawn(s, 3, 0.0, 1.0), spawn(s, 4, 1.0, 1.0), spawn(s, 5, 2.0, 1.0), spawn(s, 6, 0.0, 2.0), spawn(s, 7, 1.0, 2.0))

def tree(+d: Nat, +k: Nat, +i: U32) -> Out:
  match d:
    case 0n:
      box(k, i)
    case 1n+p:
      a b = tree(p, k, i) tree(p, k, U32.add(i, U32.shln(1, p)))
      Out.add(a, b)

def Out.show(o: Out) -> String:
  match o:
    case Out{h, c}:
      "contacts=" ++ U32.show(h) ++ " checksum=" ++ U32.show(c)

def dep() -> Nat:
  12n

def steps() -> Nat:
  4096n

def main() -> IO(Unit):
  IO.print(Out.show(tree(dep(), steps(), 0)))
